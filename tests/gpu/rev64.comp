#version 450

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Out {
    uint xsum_lo;
    uint xsum_hi;
    uint bad_inv;
    uint bad_pop;
} o;

layout(push_constant) uniform PC {
    uint base_lo;
    uint base_hi;
    uint count;
} pc;

const uint ODD_LO = 0x7F4A7C15u;
const uint ODD_HI = 0x9E3779B9u;

shared uint s_lo[256];
shared uint s_hi[256];
shared uint s_bi[256];
shared uint s_bp[256];

uvec2 add64(uvec2 a, uint b) {
    uint lo = a.x + b;
    return uvec2(lo, a.y + ((lo < a.x) ? 1u : 0u));
}

uvec2 mul64(uvec2 idx) {
    uint msb, lsb;
    umulExtended(idx.x, ODD_LO, msb, lsb);
    return uvec2(lsb, msb + idx.x * ODD_HI + idx.y * ODD_LO);
}

uvec2 rev64(uvec2 v) {
    return uvec2(bitfieldReverse(v.y), bitfieldReverse(v.x));
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint gid = gl_GlobalInvocationID.x;
    uint nthreads = gl_NumWorkGroups.x * gl_WorkGroupSize.x;

    uint xl = 0u, xh = 0u, bi = 0u, bp = 0u;

    for (uint i = gid; i < pc.count; i += nthreads) {
        uvec2 x = mul64(add64(uvec2(pc.base_lo, pc.base_hi), i));
        uvec2 r = rev64(x);
        if (!all(equal(rev64(r), x))) bi++;
        if (bitCount(x.x) + bitCount(x.y) != bitCount(r.x) + bitCount(r.y)) bp++;
        xl ^= r.x;
        xh ^= r.y;
    }

    s_lo[tid] = xl;
    s_hi[tid] = xh;
    s_bi[tid] = bi;
    s_bp[tid] = bp;
    barrier();

    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (tid < s) {
            s_lo[tid] ^= s_lo[tid + s];
            s_hi[tid] ^= s_hi[tid + s];
            s_bi[tid] += s_bi[tid + s];
            s_bp[tid] += s_bp[tid + s];
        }
        barrier();
    }

    if (tid == 0u) {
        atomicXor(o.xsum_lo, s_lo[0]);
        atomicXor(o.xsum_hi, s_hi[0]);
        if (s_bi[0] != 0u) atomicAdd(o.bad_inv, s_bi[0]);
        if (s_bp[0] != 0u) atomicAdd(o.bad_pop, s_bp[0]);
    }
}
