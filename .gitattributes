* text=auto eol=lf

# INSTRUCTIONS.md §4.1 mandates these three. They were absent, so every
# concurrent append to the append-only docs conflicted and was hand-resolved
# by whichever session pulled second -- the mechanism the protocol relies on
# was never actually configured.
docs/DETAILS.md   merge=union
docs/ARCHIVED.md  merge=union
docs/QUESTIONS.md merge=union

*.sh    text eol=lf
*.bash  text eol=lf

*.yml   text eol=lf
*.yaml  text eol=lf

Dockerfile      text eol=lf
*.dockerfile    text eol=lf

tests/ast/*.cmake               text eol=lf
tests/ast/verify-baseline/*     text eol=lf

tests/exec/programs/grep.c      text eol=lf
